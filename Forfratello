    pcall(function()
        powerBarRef.Visible = true
    end)
    if powerBarFillRef then
        pcall(function()
            powerBarFillRef.Size = UDim2.new(1, 0, 1, 0)
        end)
    end
    local start = LocalPlayer.PlayerGui and LocalPlayer.PlayerGui:FindFirstChild("Start")
    if start then
        local points = start:FindFirstChild("Points")
        if points then
            for _, child in ipairs(points:GetChildren()) do
                if child:IsA("NumberValue") or child:IsA("IntValue") then
                    local n = child.Name:lower()
                    if n:find("charge") or n:find("power") or n:find("shot") then
                        pcall(function()
                            child.Value = child.MaxValue or 100
                        end)
                    end
                end
            end
        end
    end
end

local function lockPowerBar()
    if not powerBarRef then return end
    if powerBarFillRef then
        local conn = powerBarFillRef:GetPropertyChangedSignal("Size"):Connect(function()
            if NoShotCharge.Enabled then
                pcall(function()
                    powerBarFillRef.Size = UDim2.new(1, 0, 1, 0)
                end)
            end
        end)
        table.insert(noShotChargeConnections, conn)
    end
    local conn2 = powerBarRef:GetPropertyChangedSignal("Visible"):Connect(function()
        if NoShotCharge.Enabled then
            pcall(function()
                powerBarRef.Visible = true
            end)
        end
    end)
    table.insert(noShotChargeConnections, conn2)
end

local function startPowerBarLoop()
    local conn = RunService.RenderStepped:Connect(function()
        if not NoShotCharge.Enabled then return end
        forceFullPowerBar()
    end)
    table.insert(noShotChargeConnections, conn)
end

local function killShotAnimations()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
        local name = track.Animation and track.Animation.Name or ""
        local n = name:lower()
        if n:find("shoot") or n:find("kick") or n:find("charge")
           or n:find("volley") or n:find("header") or n:find("power") then
            pcall(function() track:Stop(0) end)
        end
    end
end

local function hookShootRemotes()
    if NoShotCharge.Hooked then return end
    local shootRemote, shootLRemote = getShootRemotes()
    if not shootRemote or not shootLRemote then
        Library:Notify({ Title = "No Shot Charge", Content = "Shoot remotes not found.", Duration = 3 })
        return
    end
    NoShotCharge.Remote = shootRemote
    NoShotCharge.RemoteL = shootLRemote

    if hookfunction then
        local ok = pcall(function()
            NoShotCharge.Original = hookfunction(shootRemote.FireServer, function(self, ...)
                if NoShotCharge.Enabled then
                    forceFullPowerBar()
                    killShotAnimations()
                end
                return NoShotCharge.Original(self, ...)
            end)
            NoShotCharge.OriginalL = hookfunction(shootLRemote.FireServer, function(self, ...)
                if NoShotCharge.Enabled then
                    forceFullPowerBar()
                    killShotAnimations()
                end
                return NoShotCharge.OriginalL(self, ...)
            end)
        end)
        if ok then
            NoShotCharge.Hooked = true
            return
        end
    end

    if hookmetamethod then
        local old
        old = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if NoShotCharge.Enabled and method == "FireServer" then
                if self == shootRemote or self == shootLRemote then
                    forceFullPowerBar()
                    killShotAnimations()
                end
            end
            return old(self, ...)
        end)
        NoShotCharge.Hooked = true
        return
    end

    local mt = getrawmetatable(game)
    if mt then
        setreadonly(mt, false)
        local oldNC = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if NoShotCharge.Enabled and method == "FireServer" then
                if self == shootRemote or self == shootLRemote then
                    forceFullPowerBar()
                    killShotAnimations()
                end
            end
            return oldNC(self, ...)
        end)
        setreadonly(mt, true)
        NoShotCharge.Hooked = true
    end
end

local function activateNoShotCharge()
    powerBarRef = findPowerBar()
    if powerBarRef then
        powerBarFillRef = findPowerBarFill(powerBarRef)
        forceFullPowerBar()
        lockPowerBar()
    end

    hookShootRemotes()
    startPowerBarLoop()

    local mouseConn = UserInputService.InputEnded:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not NoShotCharge.Enabled then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            killShotAnimations()
        end
    end)
    table.insert(noShotChargeConnections, mouseConn)

    local charAddedConn = LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        if not NoShotCharge.Enabled then return end
        powerBarRef = findPowerBar()
        powerBarFillRef = findPowerBarFill(powerBarRef)
        forceFullPowerBar()
        lockPowerBar()
    end)
    table.insert(noShotChargeConnections, charAddedConn)

    Library:Notify({ Title = "No Shot Charge", Content = "Enabled", Duration = 3 })
end

local function deactivateNoShotCharge()
    NoShotCharge.Enabled = false
    for _, conn in ipairs(noShotChargeConnections) do
        pcall(function() conn:Disconnect() end)
    end
    noShotChargeConnections = {}
    powerBarRef = nil
    powerBarFillRef = nil
    Library:Notify({ Title = "No Shot Charge", Content = "Disabled", Duration = 3 })
end

