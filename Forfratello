local function findPowerBar()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local start = pg:FindFirstChild("Start")
    if not start then return nil end
    local powerBar = start:FindFirstChild("PowerBar", true)
    if powerBar then return powerBar end
    for _, desc in ipairs(start:GetDescendants()) do
        if desc:IsA("Frame") or desc:IsA("ImageLabel") then
            local n = desc.Name:lower()
            if n:find("power") or n:find("charge") or n:find("bar") then
                return desc
            end
        end
    end
    return nil
end

local function findPowerBarFill(powerBar)
    if not powerBar then return nil end
    for _, child in ipairs(powerBar:GetDescendants()) do
        local n = child.Name:lower()
        if (child:IsA("Frame") or child:IsA("ImageLabel"))
           and (n:find("fill") or n:find("progress") or n:find("bar")) then
            return child
        end
    end
    for _, child in ipairs(powerBar:GetChildren()) do
        if child:IsA("Frame") or child:IsA("ImageLabel") then
            return child
        end
    end
    return nil
end

