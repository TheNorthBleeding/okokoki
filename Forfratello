end

if shootRemote and shootRemote:IsA("RemoteEvent") and shootLRemote and shootLRemote:IsA("RemoteEvent") then
    local oldFireServerShoot  = shootRemote.FireServer
    local oldFireServerShootL = shootLRemote.FireServer

    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local oldNamecall = mt.__namecall
    mt.__namecall = newcclosure(function(self, ...)
        if getnamecallmethod() == "FireServer" then
            if self == shootRemote then
                local args = { ... }
                for _ = 1, 10 do
                    oldFireServerShoot(self, unpack(args))
                end
            elseif self == shootLRemote then
                local args = { ... }
                for _ = 1, 10 do
                    oldFireServerShootL(self, unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    setreadonly(mt, true)
else
    warn("Delay Reducer: Required remotes not found.")
end

local function getClosestBall()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local closest, minDist = nil, math.huge
    for _, ball in ipairs(FindAllBalls()) do
        local dist = (hrp.Position - ball.Position).Magnitude
        if dist < minDist then
            minDist = dist
            closest = ball
        end
    end
    return closest, minDist
end

local function fireScorerRemote()
    local scorerRemote = Workspace:FindFirstChild("FE")
    if scorerRemote and scorerRemote:FindFirstChild("Scorer") then
        scorerRemote = scorerRemote.Scorer:FindFirstChild("RemoteEvent")
    end
    if scorerRemote and scorerRemote:IsA("RemoteEvent") then
        pcall(function()
            scorerRemote:FireServer(unpack({}))
        end)
    end
end

local function fireNestedRemote(path, args)
    local fe = Workspace:FindFirstChild("FE")
    if not fe then return end
    local remote = fe:FindFirstChild(path[1])
    if not remote then return end
    remote = remote:FindFirstChild(path[2])
    if not remote then return end
    for _ = 1, 15 do
        pcall(function() remote:FireServer(unpack(args)) end)
    end
end

local function fireDirectRemote(parent, child, args)
    local fe = Workspace:FindFirstChild("FE")
    if not fe then return end
    local remote = fe:FindFirstChild(parent)
    if not remote then return end
    remote = remote:FindFirstChild(child)
    if not remote then return end
    for _ = 1, 15 do
        pcall(function() remote:FireServer(unpack(args)) end)
    end
end

local shootReach, dribbleReach, tackleReach

local function fireTouchHRP(ball, reach)
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if (hrp.Position - ball.Position).Magnitude <= reach then
        for _ = 1, 30 do
            pcall(firetouchinterest, hrp, ball, 0)
            pcall(firetouchinterest, hrp, ball, 1)
            pcall(firetouchinterest, ball, hrp, 0)
            pcall(firetouchinterest, ball, hrp, 1)
        end
    end
end

local function shootQReach(targetPart)
    local char = LocalPlayer.Character
    if not char then return end
    if shootReach and shootReach > 0 then
        fireTouchHRP(targetPart, shootReach)
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        fireNestedRemote({ "Shoot", "Header" }, {})
    end
end

