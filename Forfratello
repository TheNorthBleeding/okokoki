local function FindAllBalls()
    local balls = {}
    local seen  = {}
    local function add(b)
        if b and b:IsA("BasePart") and not seen[b] then
            seen[b] = true
            table.insert(balls, b)
        end
    end
    local tps = Workspace:FindFirstChild("TPSSystem")
    if tps then add(tps:FindFirstChild("TPS")) end
    local practice = Workspace:FindFirstChild("Practice")
    if practice then
        for _, c in ipairs(practice:GetChildren()) do
            if c.Name == "PSoccerBall" then add(c) end
        end
    end
    for _, c in ipairs(Workspace:GetChildren()) do
        if c.Name == "TPS" or c.Name == "PSoccerBall" then add(c) end
    end
    return balls
end

local function FireTouchLoop()
    if not FireTouchEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local balls = FindAllBalls()
    if #balls == 0 then return end

    for _, ball in ipairs(balls) do
        if ball and ball.Parent then
            if (hrp.Position - ball.Position).Magnitude <= FireTouchReach then
                for _, limbName in ipairs(ALL_LIMBS) do
                    local limb = char:FindFirstChild(limbName)
                    if limb and limb:IsA("BasePart") then
                        pcall(function()
                            firetouchinterest(limb, ball, 0)
                            firetouchinterest(limb, ball, 1)
                        end)
                    end
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function() pcall(FireTouchLoop) end)

